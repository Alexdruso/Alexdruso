# Copy to clubsportive/.env and fill in. This file is gitignored -- never commit the real one.

# --- Clubsportive account (the same credentials you use in the app) ---
CS_USERNAME=you@example.com
CS_PASSWORD=

# --- SMTP for result mails ---
# Gmail: create an App Password (https://myaccount.google.com/apppasswords), not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=
SMTP_FROM=you@example.com
SMTP_TO=you@example.com
# SMTP_STARTTLS=1   # 1 = STARTTLS (port 587, default), 0 = implicit TLS (port 465)
